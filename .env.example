# Image tag to run. Pin a release (e.g. 0.1.0) or use `latest`.
MTG_TAG=latest

# Name of the existing external Docker network your nginx/NPM proxy uses.
# Find it with: docker network ls
PROXY_NETWORK=proxy

# Byparr solver URL (https://github.com/ThePhaseless/Byparr). The app uses it
# only as a fallback when a store answers a Cloudflare challenge / 403 / 429 /
# 503. Set to the Byparr service name on the shared Docker network. Leave empty
# to disable the fallback.
MTG_BYPARR_URL=http://byparr:8191

# Days an idle cookie-session cart survives before it and its lines are purged.
# Every cart request refreshes the timer. Default 30.
MTG_CART_TTL_DAYS=30
